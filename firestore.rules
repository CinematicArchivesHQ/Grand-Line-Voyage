rules_version = '2';
// Grand Line Voyage: only the owner's Google account may read or write its own profile.
// Replace OWNER_EMAIL with the Google account that should sync (paste these rules in
// Firebase console → Firestore Database → Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "OWNER_EMAIL"
        && request.auth.token.email_verified == true;
    }
  }
}
